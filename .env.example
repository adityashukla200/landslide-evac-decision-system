# Environment configuration for Hilly-Region Early Warning System (PS26192)
PROJECT_NAME="Hilly-Region Flash Flood & Landslide EWS"
ENVIRONMENT="development"
DEBUG=true

# Database (Default: SQLite for zero-config offline run. Set to postgresql:// for PostGIS)
DATABASE_URL="sqlite:///./data/ews.db"
# PostGIS Docker default:
# DATABASE_URL="postgresql://ews_user:ews_password@localhost:5432/ews_db"

# Redis Cache & Message Broker (Default: localhost:6379; fallback to in-memory mock when unreachable)
REDIS_URL="redis://localhost:6379/0"

# Pilot District Settings
DEFAULT_DISTRICT="Uttarkashi"
DEFAULT_STATE="Uttarakhand"

# Alert Ladder Escalation Timeout (in seconds, 300s = 5 minutes)
ALERT_ESCALATION_TIMEOUT_SECONDS=300
